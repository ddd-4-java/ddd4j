{
  "jdk": 17,
  "spring": 6,
  "boms": [
    {
      "bom": "org.springframework:spring-framework-bom",
      "property": "spring-framework.version",
      "priority": 0,
      "includes": [
        "org.springframework:*"
      ]
    },
    {
      "bom": "org.springframework.security:spring-security-bom",
      "property": "spring-security.version",
      "priority": 1,
      "includes": [
        "org.springframework.security:*"
      ]
    },
    {
      "bom": "org.springframework.data:spring-data-bom",
      "property": "spring-data-bom.version",
      "priority": 2,
      "includes": [
        "org.springframework.data:*"
      ]
    },
    {
      "bom": "io.micrometer:micrometer-bom",
      "property": "micrometer.version",
      "priority": 3,
      "includes": [
        "io.micrometer:*"
      ]
    },
    {
      "bom": "io.micrometer:micrometer-tracing-bom",
      "property": "micrometer-tracing.version",
      "priority": 4,
      "includes": [
        "io.micrometer:*"
      ]
    },
    {
      "bom": "org.slf4j:slf4j-bom",
      "property": "slf4j.version",
      "priority": 5,
      "includes": [
        "org.slf4j:*"
      ]
    },
    {
      "bom": "org.apache.logging.log4j:log4j-bom",
      "property": "log4j2.version",
      "priority": 6,
      "includes": [
        "org.apache.logging.log4j:*"
      ]
    },
    {
      "bom": "com.fasterxml.jackson:jackson-bom",
      "property": "jackson-bom.version",
      "priority": 7,
      "includes": [
        "com.fasterxml.jackson*:*"
      ]
    },
    {
      "bom": "tools.jackson:jackson-bom",
      "property": "jackson3.version",
      "priority": 8,
      "includes": [
        "tools.jackson*:*"
      ]
    },
    {
      "bom": "io.netty:netty-bom",
      "property": "netty.version",
      "priority": 9,
      "includes": [
        "io.netty:*"
      ],
      "excludes": [
        "io.netty:netty-tcnative*"
      ]
    },
    {
      "bom": "org.ow2.asm:asm-bom",
      "property": "asm.version",
      "priority": 10,
      "includes": [
        "org.ow2.asm:*"
      ]
    },
    {
      "bom": "io.opentelemetry:opentelemetry-bom",
      "property": "opentelemetry.version",
      "priority": 11,
      "includes": [
        "io.opentelemetry:*"
      ]
    },
    {
      "bom": "io.opentelemetry:opentelemetry-bom-alpha",
      "property": "opentelemetry-alpha.version",
      "priority": 12,
      "includes": [
        "io.opentelemetry:*"
      ],
      "version_suffix": "-alpha"
    },
    {
      "bom": "io.opentelemetry.instrumentation:opentelemetry-instrumentation-bom",
