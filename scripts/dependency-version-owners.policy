      "property": "quarkus-bom.version",
      "priority": 200,
      "includes": [
        "io.quarkus:*",
        "io.quarkus.platform:*",
        "io.vertx:vertx-codegen:jar:sources",
        "io.vertx:vertx-codegen:jar:tck",
        "io.vertx:vertx-codegen:jar:tck-sources"
      ]
    }
  ],
  "required_aliases": {
    "grpc-bom.version": "${grpc.version}",
    "kotlin-stdlib.version": "${kotlin.version}",
    "maven-jetty-plugin.version": "${jetty.version}",
    "opentelemetry-alpha.version": "${opentelemetry.version}-alpha",
    "opentelemetry-instrumentation-alpha.version": "${opentelemetry-instrumentation.version}-alpha",
    "opentelemetry-semconv-alpha.version": "${opentelemetry-semconv.version}-alpha"
  },
  "independent_properties": [
    "micrometer.version",
    "micrometer-tracing.version",
    "selenium-htmlunit.version",
    "opentelemetry-instrumentation.version",
    "opentelemetry-javaagent.version"
  ],
  "compatible_lines": {
    "spring-framework.version": "6.",
    "spring-security.version": "6.",
    "hibernate.version": "6.6.",
    "tomcat.version": "10.1.",
    "cxf.version": "4.1.",
    "jooq.version": "3.19.",
    "spring-initializr.version": "0.23.",
    "micronaut.core.version": "4.",
    "micronaut.version": "4.",
    "wss4j.version": "4.0."
  },
  "central_overrides": {
    "io.netty:netty-tcnative": "${netty-tcnative.version}",
    "io.netty:netty-tcnative-boringssl-static": "${netty-tcnative.version}",
    "io.netty:netty-tcnative-classes": "${netty-tcnative.version}",
    "io.vertx:vertx-codegen:jar:tests": "${vertx-compat4.version}",
    "io.vertx:vertx-consul-client:jar:tests": "${vertx-compat4.version}",
    "io.vertx:vertx-core:jar:tests": "${vertx-compat4.version}",
    "io.vertx:vertx-mail-client:jar:tests": "${vertx-compat4.version}",
    "io.vertx:vertx-mongo-client:jar:tests": "${vertx-compat4.version}",
    "io.vertx:vertx-service-discovery:jar:tests": "${vertx-compat4.version}",
    "io.vertx:vertx-sql-client:jar:tests": "${vertx-compat4.version}",
    "io.vertx:vertx-web:jar:tests": "${vertx-compat4.version}",
    "io.vertx:vertx-web-templ-freemarker:jar:tests": "${vertx-compat4.version}",
    "io.vertx:vertx-web-templ-httl:jar:tests": "${vertx-compat4.version}",
    "io.vertx:vertx-web-templ-jte:jar:tests": "${vertx-compat4.version}",
    "io.vertx:vertx-web-templ-rocker:jar:tests": "${vertx-compat4.version}",
    "io.vertx:vertx-web-templ-rythm:jar:tests": "${vertx-compat4.version}"
  },
  "runtime_overrides": [
    {
      "modules": [
        "*quarkus*",
        "*helidon*",
        "*panache*"
      ],
      "includes": [
        "io.netty:*"
      ],
      "property": "netty-4_1.version",
      "excludes": [
        "io.netty:netty-tcnative*"
      ]
    },
    {
      "modules": [
        "*quarkus*",
        "*panache*"
      ],
      "includes": [
        "io.vertx:*"
      ],
      "property": "vertx-compat4.version",
      "default_prefixes": [
        "4.",
        "5."
      ]
    },
    {
      "modules": [
        "*helidon*"
      ],
      "includes": [
        "org.glassfish.jersey*:*"
      ],
      "property": "helidon-jersey.version"
    },
    {
      "modules": [
        "*quarkus*",
        "*panache*"
      ],
      "includes": [
        "org.hibernate.orm:*"
      ],
      "property": "quarkus-hibernate.version"
    },
    {
      "modules": [
        "*quarkus*",
        "*panache*"
      ],
      "includes": [
        "io.agroal:*"
      ],
      "property": "quarkus-agroal.version"
    },
    {
      "modules": [
        "*quarkus*",
        "*panache*"
      ],
      "includes": [
        "jakarta.persistence:jakarta.persistence-api"
      ],
      "property": "jakarta.persistence-api.version"
    },
    {
      "modules": [
        "*helidon*"
      ],
      "includes": [
        "jakarta.annotation:jakarta.annotation-api"
      ],
      "property": "helidon-jakarta-annotation.version"
    },
    {
      "modules": [
        "*helidon*"
      ],
      "includes": [
        "jakarta.enterprise:jakarta.enterprise.cdi-api"
      ],
      "property": "helidon-jakarta-cdi.version"
    },
    {
      "modules": [
        "*helidon*"
      ],
      "includes": [
        "jakarta.inject:jakarta.inject-api"
      ],
      "property": "helidon-jakarta-inject.version"
    },
    {
      "modules": [
        "*helidon*"
      ],
      "includes": [
        "jakarta.interceptor:jakarta.interceptor-api"
      ],
      "property": "helidon-jakarta-interceptor.version"
    },
    {
      "modules": [
        "*helidon*"
      ],
      "includes": [
        "jakarta.ws.rs:jakarta.ws.rs-api"
      ],
      "property": "helidon-jakarta-ws-rs.version"
    }
  ],
  "update_policy": {
    "file": ".github/dependency-policy.json",
    "branch": "feature/2.0.x"
  },
  "retired_dependencies": [
    {
      "coordinates": [
        "org.apache.cxf:cxf-rt-bindings-http"
