<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-extensions</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-extension-excel</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Ddd4j Excel Component — ExcelKit facade on top of Alibaba EasyExcel 4.x (pure Java, no Spring)</description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencies>
        <!-- For EasyExcel: 复用原生注解(@ExcelProperty/@ExcelIgnore/@ColumnWidth 等)、EasyExcel、ExcelWriter、Converter、WriteHandler -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
        </dependency>
        <!-- For ddd4j-core: 复用 BizRuntimeException / I18nKit 等基础设施 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- For Apache Commons: ExceptionUtils / StringUtils -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <!-- For Apache Commons IO: IOUtils / ByteArrayXXXStream 等 -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
        </dependency>

        <!-- For Test: AssertJ -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
