<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-samples</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-sample-javalin-satoken</artifactId>
    <packaging>jar</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Javalin + Guice + Sa-Token 鉴权示例：演示无 DI 容器框架下 SubjectKit 统一鉴权入口</description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencies>
        <!-- ddd4j core：核心 DDD/CQRS 抽象（API、Page、Repository、AggregateRoot 等） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- ddd4j kit：通用工具包（StrKit 等） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-kit</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- ddd4j auth sa-token 适配（纯 Java） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-auth-satoken</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- ddd4j Guice 运行时绑定（SPI 注入 + Javalin 基础设施） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-runtime-guice</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- ================= Javalin & Guice ================= -->
        <!-- Javalin Web 框架 + Google Guice（ddd4j-runtime-guice 已传递依赖） -->

        <!-- ================= Lombok ================= -->

        <!-- 1.0.x uses Javalin 4 with its Java 8 compatible Jetty 9 runtime. -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
        </dependency>
        <!-- Jackson：Javalin 默认 JSON 序列化（J3 中 jsr310 已内置于 databind） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ================= 测试依赖 ================= -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>${skipTests}</skipTests>
                    <skip>${skipTests}</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
