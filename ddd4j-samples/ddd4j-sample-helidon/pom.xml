        <helidon.annotation.version>${helidon-jakarta-annotation.version}</helidon.annotation.version>
        <!-- Helidon 3.2.18 的 Jersey 兼容基线，不能继承通用 3.1.x 管理。 -->
        <helidon.jersey.version>${helidon-jersey.version}</helidon.jersey.version>
    </properties>

