<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-parent/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-samples</artifactId>
    <packaging>pom</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 框架无关的业务内核与非 Spring Boot 运行时示例。</description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <properties>
        <!-- 示例模块仅用于演示与测试，不发布到远程仓库 -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <subprojects>
        <!-- 跨运行时共享的生产型订单业务内核 -->
        <subproject>ddd4j-sample-order-domain</subproject>
        <subproject>ddd4j-sample-order-application</subproject>
        <subproject>ddd4j-sample-order-local</subproject>
        <subproject>ddd4j-sample-order-testkit</subproject>
        <subproject>ddd4j-sample-order-jdbc</subproject>
        <subproject>ddd4j-sample-order-kafka</subproject>
        <subproject>ddd4j-sample-order-redis</subproject>

        <!-- 非 Boot 运行时示例：Order 充血模型、CQRS、缓存与消息边界。 -->
        <subproject>ddd4j-sample-quarkus</subproject>
        <subproject>ddd4j-sample-javalin</subproject>
        <subproject>ddd4j-sample-micronaut</subproject>
        <subproject>ddd4j-sample-vertx</subproject>
        <subproject>ddd4j-sample-helidon</subproject>
        <subproject>ddd4j-sample-dropwizard</subproject>

        <!-- CQRS/ES 示例：演示 Order + Goods 读写分离 + 缓存。 -->
        <subproject>ddd4j-sample-quarkus-cqrs</subproject>
        <subproject>ddd4j-sample-javalin-cqrs</subproject>
        <subproject>ddd4j-sample-micronaut-cqrs</subproject>

        <!-- Auth 鉴权矩阵：Boot 专属实现位于外部 ddd4j-boot。 -->
        <subproject>ddd4j-sample-quarkus-satoken</subproject>
        <subproject>ddd4j-sample-quarkus-shiro</subproject>
        <subproject>ddd4j-sample-javalin-satoken</subproject>
        <subproject>ddd4j-sample-javalin-shiro</subproject>
    </subprojects>

</project>
