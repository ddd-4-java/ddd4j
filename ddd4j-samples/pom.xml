<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-parent/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-samples</artifactId>
    <packaging>pom</packaging>
    <description>ddd4j 框架无关的核心架构示例（DDD/CQRS/Cache + Auth 鉴权矩阵）</description>

    <modules>
        <!-- 核心 DDD 示例：每框架一个，演示 Order 充血模型 + Goods 第三轨 + Cache + MQ -->
        <module>ddd4j-sample-spring</module>
        <module>ddd4j-sample-quarkus</module>
        <module>ddd4j-sample-javalin</module>

        <!-- CQRS/ES 示例：每框架一个，演示 Order + Goods 读写分离 + 缓存 -->
        <module>ddd4j-sample-spring-cqrs</module>
        <module>ddd4j-sample-quarkus-cqrs</module>
        <module>ddd4j-sample-javalin-cqrs</module>

        <!-- Auth 鉴权矩阵：框架 × 认证方案（业务代码全部一致） -->
        <module>ddd4j-sample-spring-satoken</module>
        <module>ddd4j-sample-spring-shiro</module>
        <module>ddd4j-sample-spring-security</module>
        <module>ddd4j-sample-quarkus-satoken</module>
        <module>ddd4j-sample-quarkus-shiro</module>
        <module>ddd4j-sample-javalin-satoken</module>
        <module>ddd4j-sample-javalin-shiro</module>
    </modules>

</project>
