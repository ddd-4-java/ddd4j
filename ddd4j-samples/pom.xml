<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-parent/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-samples</artifactId>
    <packaging>pom</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 框架无关的业务内核与非 Spring Boot 运行时示例。</description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <properties>
        <!-- 示例模块仅用于演示与测试，不发布到远程仓库 -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <spring-boot4-it.version>4.0.8</spring-boot4-it.version>
        <quarkus-hibernate-orm.version>7.3.6.Final</quarkus-hibernate-orm.version>
        <quarkus-agroal.version>3.2.1</quarkus-agroal.version>
        <quarkus-failsafe-plugin.version>3.2.5</quarkus-failsafe-plugin.version>
        <quarkus-surefire-plugin.version>3.2.5</quarkus-surefire-plugin.version>
        <vertx-compat4.version>4.5.35</vertx-compat4.version>
        <helidon-jersey.version>3.0.18</helidon-jersey.version>
        <helidon-jakarta-ws-rs.version>3.0.0</helidon-jakarta-ws-rs.version>
        <helidon-jakarta-interceptor.version>2.0.0</helidon-jakarta-interceptor.version>
        <helidon-jakarta-inject.version>2.0.0</helidon-jakarta-inject.version>
        <helidon-jakarta-cdi.version>3.0.0</helidon-jakarta-cdi.version>
        <helidon-jakarta-annotation.version>2.0.0</helidon-jakarta-annotation.version>
    </properties>

    <modules>
        <module>ddd4j-sample-order-domain</module>
        <module>ddd4j-sample-order-application</module>
        <module>ddd4j-sample-order-testkit</module>
        <module>ddd4j-sample-order-jdbc</module>
        <module>ddd4j-sample-order-adapter</module>
        <module>ddd4j-sample-order-start</module>
        <module>ddd4j-sample-spring</module>
        <module>ddd4j-sample-spring-cqrs</module>
        <module>ddd4j-sample-spring-satoken</module>
        <module>ddd4j-sample-spring-shiro</module>
        <module>ddd4j-sample-quarkus</module>
        <module>ddd4j-sample-javalin</module>
        <module>ddd4j-sample-micronaut</module>
        <module>ddd4j-sample-vertx</module>
        <module>ddd4j-sample-helidon</module>
        <module>ddd4j-sample-dropwizard</module>
        <module>ddd4j-sample-quarkus-cqrs</module>
        <module>ddd4j-sample-javalin-cqrs</module>
        <module>ddd4j-sample-dropwizard-cqrs</module>
        <module>ddd4j-sample-dropwizard-satoken</module>
        <module>ddd4j-sample-dropwizard-shiro</module>
        <module>ddd4j-sample-helidon-cqrs</module>
        <module>ddd4j-sample-helidon-satoken</module>
        <module>ddd4j-sample-helidon-shiro</module>
        <module>ddd4j-sample-micronaut-cqrs</module>
        <module>ddd4j-sample-vertx-cqrs</module>
        <module>ddd4j-sample-vertx-satoken</module>
        <module>ddd4j-sample-vertx-shiro</module>
        <module>ddd4j-sample-quarkus-satoken</module>
        <module>ddd4j-sample-quarkus-shiro</module>
        <module>ddd4j-sample-javalin-satoken</module>
        <module>ddd4j-sample-javalin-shiro</module>
        <module>ddd4j-sample-micronaut-satoken</module>
        <module>ddd4j-sample-micronaut-shiro</module>
    </modules>

</project>
