<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../ddd4j-parent/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-sample-auth-shiro</artifactId>
    <packaging>jar</packaging>
    <description>ddd4j-auth + Apache Shiro 集成示例：演示 SubjectKit 统一鉴权入口（旧项目迁移参考）</description>

    <properties>
        <spring-boot.version>3.5.6</spring-boot.version>
        <shiro.version>2.0.6</shiro.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ddd4j auth shiro 适配（纯 Java） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-auth-shiro</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- ddd4j auth spring 桥接（自动注册 SubjectProvider） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-auth-spring</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Apache Shiro（jakarta 兼容版本） -->
        <dependency>
            <groupId>org.apache.shiro</groupId>
            <artifactId>shiro-core</artifactId>
            <version>${shiro.version}</version>
        </dependency>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

</project>
