<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- POM的模型版本 -->
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.ddd4j</groupId>
    <artifactId>ddd4j</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>ddd4j</name>
    <description>Ddd4j For Java Projects</description>

    <scm>
        <connection>scm:git:https:codeup.aliyun.com/5fdc0afd99b59ba3c5ead757/ddd4j/${project.artifactId}.git
        </connection>
        <developerConnection>scm:git:https:codeup.aliyun.com/5fdc0afd99b59ba3c5ead757/ddd4j/${project.artifactId}.git
        </developerConnection>
        <url>https://codeup.aliyun.com/5fdc0afd99b59ba3c5ead757/ddd4j/${project.artifactId}</url>
        <tag>${project.artifactId}</tag>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <revision>2.0.x.20260625-SNAPSHOT</revision>
        <java.version>17</java.version>
        <lombok.version>1.18.46</lombok.version>
        <!-- P0-2: 单元测试开关（默认运行，业务项目可 -DskipTests 跳过） -->
        <skipTests>false</skipTests>
        <!-- Maven Plugin versions -->
        <maven.version>3.6.3</maven.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <maven-flatten-plugin.version>1.7.3</maven-flatten-plugin.version>
        <maven-nexus-staging-plugin.version>1.7.0</maven-nexus-staging-plugin.version>
        <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
        <!-- Dependency versions -->
        <spring-amqp.version>3.2.5</spring-amqp.version>
        <spring-authorization-server.version>1.4.3</spring-authorization-server.version>
        <spring-batch.version>5.2.2</spring-batch.version>
        <spring-data-bom.version>2024.1.5</spring-data-bom.version>
        <!-- 版本约束：Spring Framework 锁定 6.x，不得升级至 7.x -->
        <spring-framework.version>6.2.19</spring-framework.version>
        <spring-graphql.version>1.4.6</spring-graphql.version>
        <spring-hateoas.version>2.4.1</spring-hateoas.version>
        <spring-integration.version>6.5.10</spring-integration.version>
        <spring-kafka.version>3.3.5</spring-kafka.version>
        <spring-ldap.version>3.2.12</spring-ldap.version>
        <spring-pulsar.version>1.2.5</spring-pulsar.version>
        <spring-restdocs.version>3.0.3</spring-restdocs.version>
        <spring-retry.version>2.0.11</spring-retry.version>
        <spring-security.version>6.4.6</spring-security.version>
        <spring-session.version>3.4.3</spring-session.version>
        <spring-ws.version>4.0.13</spring-ws.version>
        <reactor-bom.version>2025.0.6</reactor-bom.version>
        <jackson.version>2.22.0</jackson.version>
        <jackson-bom.version>${jackson.version}</jackson-bom.version>
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
        <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    </properties>

    <modules>
        <module>ddd4j-bom</module>
        <module>ddd4j-dependencies</module>
        <!-- 注解层：零框架依赖（仅 spring-context） -->
        <module>ddd4j-annotation</module>
        <module>ddd4j-core</module>
        <!-- 工具箱：继承式增强 Hutool（与 ddd4j-core 同级的基础设施） -->
        <module>ddd4j-kit</module>
        <!-- 监控告警：钉钉/企微机器人 + 日志告警（与 ddd4j-core 同级） -->
        <!-- 纯 DDD 轨道：集成 fuinorg ddd-4-java + cqrs-4-java，领域层零 MyBatis Plus 依赖 -->
        <module>ddd4j-ddd</module>

        <!-- 业务模块聚合层（xxx-core 纯 Java 抽象 + xxx-spring 桥接 + xxx-* 框架实现） -->
        <module>ddd4j-data</module>
        <module>ddd4j-mq</module>
        <module>ddd4j-web</module>
        <module>ddd4j-auth</module>
        <module>ddd4j-cache</module>

        <!-- 三框架核心适配层（与 ddd4j-core 同级，提供 3 个核心 SPI 的框架实现） -->
        <module>ddd4j-spring</module>
        <module>ddd4j-quarkus</module>
        <module>ddd4j-guice</module>

        <!-- 业务模块 × 三框架 整合模块（ddd4j-{data,mq,web,auth}-{spring,quarkus,guice}）已下沉到各自业务聚合层下 -->
        <!-- 跨领域扩展（akka/excel/jackson/pf4j/qlexpress） -->
        <module>ddd4j-extensions</module>
        <module>ddd4j-parent</module>
        <module>ddd4j-samples</module>
    </modules>

    <!--开源协议采用Apache 2.0协议-->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- 组织信息 -->
    <organization>
        <name>Hiwepy</name>
        <url>https://wiki.hiwepy.com</url>
    </organization>

    <!-- 开发者信息 -->
    <developers>
        <developer>
            <name>wandl</name>
            <email>hiwepy@gmail.com</email>
            <organization>hiwepy</organization>
            <organizationUrl>https://wiki.hiwepy.com</organizationUrl>
            <roles>
                <role>developer</role>
            </roles>
            <timezone>+8</timezone>
        </developer>
    </developers>

