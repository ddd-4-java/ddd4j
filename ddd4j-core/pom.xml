<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-core</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 核心契约层：纯 Java DDD
        契约（AggregateRoot/DomainRepository/DomainObjectMapper/Model/Query/Page/R/BaseRepository/DomainEvent/DomainEventPublisher）、上下文（ThreadContext/BaseContext）、DDD
        构建块（DddAggregateRoot）。零框架依赖。
    </description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencies>
        <!-- ======== 内部模块 ======== -->
        <!-- DDD 构造型注解（纯 Java） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-annotation</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 工具箱（JsonKit/StrKit/FunctionKit） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-kit</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- ======== 序列化（有意保留） ======== -->
        <!-- Jackson databind：ddd4j-core 事件载荷序列化契约依赖 Jackson（JsonKit/DomainEvent），
             属有意保留；事件 payload 的 JSON 往返是核心契约。 -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Jackson annotations（com.fasterxml.jackson 2.x）：@JsonProperty/@JsonCreator/@JsonIgnore/@JsonValue
             保证 DomainEvent/EventId/AggregateVersion/EntityIdPath 等事件/实体 JSON 往返稳定；
             Jackson 3 的 databind 兼容 Jackson 2 注解包，两者需同时保留。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!-- ======== 线程上下文透传（有意保留） ======== -->
        <!-- TransmittableThreadLocal：ThreadContext 使用 TTL 实现跨线程池的上下文透传（租户/Subject/requestId），
             ddd4j-web 运行时（Spring/Quarkus/Micronaut 等）在异步线程中依赖此语义。
             JDK 21 ScopedValue 可作为未来替代，当前保留 TTL 以兼容 Java 17+ 运行时。 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>transmittable-thread-local</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 覆盖 parent 的 surefire skip=true，本模块允许运行 ArchUnit 测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                    <argLine>-Xmx1024m -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
