<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-quarkus</artifactId>
    <description>Ddd4j Quarkus 框架核心适配：3 个核心 SPI 的 CDI 实现（DomainEventPublisher/SubjectProvider/I18nProvider）。与
        ddd4j-spring、ddd4j-guice 平级。
    </description>

    <dependencies>
        <!-- 纯 Java 核心契约 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Quarkus Arc (CDI) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Quarkus Core -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-core</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
