<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-projection-quarkus</artifactId>
    <properties>
        <quarkus.version>1.13.7.Final</quarkus.version>
    </properties>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 投影调度 Quarkus CDI 适配（Quarkus 运行时）： QuarkusProjectionScheduler 以 @ApplicationScoped 实现
        ViewScheduler SPI （ScheduledExecutorService + CronExpression 兜底——Quarkus 1.x 由 JDK 调度兜底
        调度），QuarkusProjectionViewManager 以 @ApplicationScoped 实现 ViewManager SPI（ArC Instance 收集 ProjectionView
        Bean + ProjectionRunner 驱动 runOnce），零新框架抽象——投影契约全部复用 ddd4j-core。
    </description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.eclipse.microprofile.config</groupId>
                <artifactId>microprofile-config-api</artifactId>
                <version>1.4</version>
            </dependency>
            <!-- JDK 8 使用 Quarkus 1.13.7.Final；MicroProfile Config 固定为其 BOM 的 1.4。 -->
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- For DDD4j -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-data-projection</artifactId>
            <version>${revision}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Quarkus ArC（CDI 运行时）：@ApplicationScoped/@Inject/Instance 收集，
             BOM 管理无版本 -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>

        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
        </dependency>
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
        </dependency>
        <!-- ======== Test ======== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Quarkus JUnit 5 集成（@QuarkusTest 真实 ArC 容器引导；BOM 管理） -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- surefire 默认不含 *IT.java；本模块的 @QuarkusTest 集成测试随 test
                 阶段执行，需在父配置（**/*Test.java 之外）追加 IT 模式。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
