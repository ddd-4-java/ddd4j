<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>3.0.x.20260630-SNAPSHOT</version>
    </parent>

    <artifactId>ddd4j-data-cqrs-spring</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j CQRS Spring 适配（Spring WebMVC/WebFlux + Helidon-Spring）： SpringCommandBus 以 @Component 继承
        ddd4j-core DefaultCommandBus（ADR-0004： 命令分发唯一入口，零新框架抽象），构造期经 ApplicationContext.getBeansOfType
        收集 CommandExecutor Bean 注册 CommandRegistry，类级 @Transactional 包 execute。
    </description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <properties>
        <!-- JDK 21 / Spring Framework 7 测试栈使用 Spring Boot 4。 -->
        <spring-boot-it.version>${spring-boot4-it.version}</spring-boot-it.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- For DDD4j -->
        <!-- Spring Context：@Component + ApplicationContext 收集，版本由 Spring Framework BOM 管理。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- Spring TX：类级 org.springframework.transaction.annotation.Transactional 刻板 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>

        <!-- ======== Test ======== -->
        <!-- Spring Boot Test（@SpringBootTest + ApplicationContextRunner 测试栈）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot-it.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 将事务自动配置拆为独立模块；真实容器 IT 需验证事务代理。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-transaction</artifactId>
            <version>${spring-boot-it.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- surefire 默认不含 *IT.java；本模块的集成测试（真实 Spring 容器）随 test
                 阶段执行，需在父配置（**/*Test.java 之外）追加 IT 模式。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
