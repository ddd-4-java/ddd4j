<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-projection-helidon</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 投影调度 Helidon SE 适配（Helidon 运行时）：
        HelidonProjectionScheduler 以 @Singleton 实现 ViewScheduler SPI
        （ScheduledExecutorService + CronExpression 兜底——Helidon SE 无内置 cron 调度，
        退化为 JDK 调度），HelidonProjectionViewManager 以 @Singleton
        实现 ViewManager SPI（ServiceLoader 风格发现 ProjectionView + ProjectionRunner
        驱动 runOnce），手动 start——投影契约全部复用 ddd4j-core。
    </description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencies>
        <!-- For DDD4j -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-data-projection</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Helidon Common Service Loader（Helidon SE 的服务发现原语：对 JDK ServiceLoader
             的优先级排序/排除包装，本模块不开 MicroProfile CDI——SE 线的 Bean 装配即
             ServiceLoader 风格。版本由 ddd4j-dependencies 导入的
             io.helidon:helidon-bom（${helidon-bom.version}=3.2.18）管理，刻意不声明） -->
        <dependency>
            <groupId>io.helidon.common</groupId>
            <artifactId>helidon-common-service-loader</artifactId>
        </dependency>
        <!-- Jakarta Inject（@Singleton/@Inject 刻板注解；helidon-core 线自身即用
             jakarta.inject 而非 CDI，DDD4j 依赖链管理 = 2.0.1，刻意不声明） -->
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>

        <!-- ======== Test ======== -->
        <!-- Helidon SE JUnit 5 测试栈（坐标实证：ddd4j-data-cqrs-helidon 实证的
             io.helidon.common.testing:helidon-common-testing-junit5；BOM 管理无版本） -->
        <dependency>
            <groupId>io.helidon.common.testing</groupId>
            <artifactId>helidon-common-testing-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- surefire 默认不含 *IT.java；本模块的集成测试（真实 ServiceLoader 发现）
                 随 test 阶段执行，需在父配置（**/*Test.java 之外）追加 IT 模式。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
