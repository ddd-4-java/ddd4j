<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-projection-spring</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 投影调度 Spring 适配（Spring WebMVC/WebFlux）： SpringProjectionScheduler 以 @Component +
        SmartLifecycle 实现 ViewScheduler SPI （TaskScheduler.schedule + CronTrigger 注册定时任务），SpringProjectionViewManager
        以 @Component 实现 ViewManager SPI（收集 ProjectionView Bean + ProjectionRunner 驱动 runOnce），零新框架抽象——投影契约全部复用
        ddd4j-core。
    </description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <properties>
        <!-- JDK 8 测试栈与本线 Spring Framework 5.3 保持一致。 -->
        <spring-boot-it.version>${spring-boot2-it.version}</spring-boot-it.version>
    </properties>

    <dependencies>
        <!-- For DDD4j -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-data-projection</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Spring Context：@Component + SmartLifecycle + TaskScheduler + CronTrigger，
             版本由本线 Spring BOM 管理。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- Spring TX：声明式事务支持（版本由 spring-framework-bom 管理） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>

        <!-- ======== Test ======== -->
        <!-- Spring Boot 2.7 Test 仅用于本线真实容器测试。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot-it.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 2.7 的 YAML loader 依赖 SnakeYAML 1.x 构造器。 -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>${snakeyaml-boot2.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- surefire 默认不含 *IT.java；本模块的集成测试（真实 Spring 容器）随 test
                 阶段执行，需在父配置（**/*Test.java 之外）追加 IT 模式。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
