<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data</artifactId>
    <packaging>pom</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 数据层聚合根：cqrs/projection/event-store 各框架实现 + crypto/external/logs/mybatis/mybatisplus/jpa/datascope 扩展（与 2.0.x/3.0.x 拓扑对齐）。</description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <!--
        2026-09-04 ddd4j-data 转为 packaging=pom 聚合根（与 2.0.x/3.0.x 对齐）：
        原 ddd4j-data 根 src 的 19 个共享类（annotation/config/typehandlers/旧版 BaseRepositoryImpl）
        已删除——它们是过时代码：
        - 6 个 orm 注解已被 ddd4j-annotation/orm 取代
        - 10 个 typehandlers 已不再使用（MyBatis-Plus 集成移至 ddd4j-data-mybatisplus 子模块）
        - 旧版 BaseRepositoryImpl 与 ddd4j-data-mybatisplus 子模块重复
        子模块各自自包含，无外部共享代码需求。
    -->

    <modules>
        <!--
            2026-09-05 补全：19 个子模块从 1240dd4c（pre-sync JDK8/javax 线）恢复并纳入 reactor。
            仍排除（允许轴）：
            - Quarkus 需 JDK17+，panache 为 Quarkus 专属：
              ddd4j-data-cqrs-quarkus / ddd4j-data-projection-quarkus /
              ddd4j-data-event-store-panache / ddd4j-data-projection-panache
            - Helidon 适配器：helidon-common-service-loader 2.6.14 构件为 Java 11 字节码
              （major 55），JDK 8 无法编译：
              ddd4j-data-cqrs-helidon / ddd4j-data-projection-helidon
        -->
        <!-- cqrs 核心 -->
        <module>ddd4j-data-cqrs</module>
        <!-- cqrs 框架桥接 -->
        <module>ddd4j-data-cqrs-javalin</module>
        <module>ddd4j-data-cqrs-dropwizard</module>
        <module>ddd4j-data-cqrs-vertx</module>
        <module>ddd4j-data-cqrs-spring</module>
        <module>ddd4j-data-cqrs-micronaut</module>
        <!-- event-store（javax.persistence / JDBI3 线） -->
        <module>ddd4j-data-event-store-jpa</module>
        <module>ddd4j-data-event-store-jdbi</module>
        <module>ddd4j-data-event-store-esdb</module>
        <module>ddd4j-data-event-store-r2dbc</module>
        <!-- projection 核心 + 框架桥接 + 持久化 -->
        <module>ddd4j-data-projection</module>
        <module>ddd4j-data-projection-javalin</module>
        <module>ddd4j-data-projection-dropwizard</module>
        <module>ddd4j-data-projection-vertx</module>
        <module>ddd4j-data-projection-spring</module>
        <module>ddd4j-data-projection-micronaut</module>
        <module>ddd4j-data-projection-jpa</module>
        <module>ddd4j-data-projection-jdbi</module>
        <module>ddd4j-data-projection-r2dbc</module>
        <!-- 扩展 -->
        <module>ddd4j-data-mybatis</module>
        <module>ddd4j-data-mybatisplus</module>
        <module>ddd4j-data-crypto</module>
        <module>ddd4j-data-logs</module>
        <module>ddd4j-data-external</module>
        <module>ddd4j-data-datascope</module>
        <module>ddd4j-data-jpa</module>
    </modules>

</project>
