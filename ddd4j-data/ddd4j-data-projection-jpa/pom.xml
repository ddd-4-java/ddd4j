<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>3.0.x.20260630-SNAPSHOT</version>
    </parent>

    <artifactId>ddd4j-data-projection-jpa</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 投影位置 JPA 实现（Spring WebMVC/WebFlux 等 Spring 系运行时）： 基于 Spring Data JPA 落地 core 的 ProjectionPositionRepository SPI（接口在 io.ddd4j.core.cqrs.readmodel，本模块不重定义），ProjectionPositionEntity + SpringDataProjectionPositionRepository + JpaProjectionPositionRepository 组装。</description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <properties>
        <!-- 仅本模块的 Spring Data JPA 与 H2 集成测试栈使用。
             3.0.x 基于 Spring Framework 7，因此必须使用同线的 Boot 4。 -->
        <spring-boot-it.version>${spring-boot4-it.version}</spring-boot-it.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 子模块局部覆盖父级 Boot 3 管理项，避免 Boot 4 starter 与 Boot 3 core 混装。 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot-it.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- For DDD4j -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-data-projection</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Spring 刻板注解（@Repository 等，spring-framework-bom 管版本） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- Spring 声明式事务（@Transactional，spring-framework-bom 管版本） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <!-- Spring Data JPA：由 Boot 4 BOM 与 Spring Framework 7 统一管理。 -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-jpa</artifactId>
        </dependency>
        <!-- Spring Data Commons：与 Spring Data JPA 同线。 -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>
        <!-- Jakarta Persistence API（实体映射）：由 Boot 4 BOM 管理。 -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- ======== Test ======== -->
        <!-- Spring Boot Data JPA（仅测试作用域，不进入模块对外依赖面）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <version>${spring-boot-it.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot Test（@SpringBootTest + AssertJ/JUnit5 测试栈，test 作用域） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot-it.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Hibernate ORM：由 Boot 4 BOM 管理，仅用于集成测试。 -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H2 内存库（IT 数据源；版本由 ddd4j-dependencies 的 h2.version 管理） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- surefire 默认不含 *IT.java；本模块的集成测试随 test 阶段执行，
                 需在父配置（**/*Test.java 之外）追加 IT 模式。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
