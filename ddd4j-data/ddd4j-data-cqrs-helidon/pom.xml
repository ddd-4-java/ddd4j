<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-cqrs-helidon</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j CQRS Helidon SE 适配：HelidonCommandBus 以 @Singleton 继承 ddd4j-core
        DefaultCommandBus（ADR-0004：命令分发唯一入口，零新框架抽象）， 构造期经 HelidonServiceLoader（Helidon SE 的
        ServiceLoader 发现原语， 不开 MicroProfile CDI）收集 CommandExecutor 服务注册 CommandRegistry。 事务刻意不引入（Helidon
        的事务栈 helidon-data-tx-jpa 与本模块解耦， @Transactional 由集成方标注在 service 层）。
    </description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencies>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- For DDD4j -->
        <!-- Helidon Common Service Loader（Helidon SE 的服务发现原语：对 JDK ServiceLoader
             的优先级排序/排除包装，本模块不开 MicroProfile CDI——SE 线的 Bean 装配即
             ServiceLoader 风格。JDK 8 线固定使用 Helidon 1.4.19） -->
        <dependency>
            <groupId>io.helidon.common</groupId>
            <artifactId>helidon-common-service-loader</artifactId>
            <version>1.4.19</version>
        </dependency>
        <!-- Javax Inject（@Singleton/@Inject 刻板注解；JDK 8 线使用 javax.inject） -->
        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
        </dependency>

        <!-- ======== Test ======== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- surefire 默认不含 *IT.java；本模块的集成测试（真实 ServiceLoader 发现）
                 随 test 阶段执行，需在父配置（**/*Test.java 之外）追加 IT 模式。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
