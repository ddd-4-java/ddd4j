<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-spring</artifactId>
    <description>ddd4j Data - Spring 桥接：Repository Bean 注册、静态注册表初始化、mapper 注入。承担 ddd4j-data-mybatis 与
        Spring 容器的桥接职责（非 Spring Boot auto-config，auto-config 在 ddd4j-boot-data）。
    </description>

    <dependencies>
        <!-- 纯 MyBatis 实现 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-data-mybatis</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Spring 桥接层 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-spring</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Spring TX（@Transactional 支持） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <!-- Spring Beans（BeanPostProcessor） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
        </dependency>
    </dependencies>

</project>
