<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-projection-dropwizard</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 投影调度 Dropwizard 5 适配：DropwizardProjectionScheduler 以静态 create(Environment, Collection,
        ProjectionRunner) 工厂实现 ViewScheduler SPI（JDK ScheduledExecutorService + CronExpression——与 Quarkus 模式同款），
        DropwizardProjectionViewManager 以静态 create 工厂实现 ViewManager SPI（遍历 views 按 cron 调度， triggerOnce 驱动
        ProjectionRunner.runAll），零新框架抽象——投影契约全部复用 ddd4j-core。
    </description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencies>
        <!-- For DDD4j -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-data-projection</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Dropwizard 核心（Jetty/Jersey/Jackson 装配栈，无 DI 容器；版本由
             ddd4j-dependencies:2886-2888 导入的 io.dropwizard:dropwizard-bom
             （${dropwizard-bom.version}=5.0.2）管理，刻意不声明） -->
        <dependency>
            <groupId>io.dropwizard</groupId>
            <artifactId>dropwizard-core</artifactId>
        </dependency>

        <!-- ======== Test ======== -->
        <!-- Dropwizard 测试支持（DropwizardTestSupport 启动真实 Jersey/Jetty 容器；
             版本由 dropwizard-bom 5.0.2 管理，刻意不声明） -->
        <dependency>
            <groupId>io.dropwizard</groupId>
            <artifactId>dropwizard-testing</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- surefire 默认不含 *IT.java；本模块的集成测试（真实 Dropwizard 启动）
                 随 test 阶段执行，需在父配置（**/*Test.java 之外）追加 IT 模式。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
