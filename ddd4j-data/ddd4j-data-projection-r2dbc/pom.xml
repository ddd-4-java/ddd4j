<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-projection-r2dbc</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 投影位置 R2DBC 响应式实现（WebFlux/Vert.x 等响应式运行时）：
        纯 io.r2dbc.spi Connection API 落地 core 的 ProjectionPositionRepository SPI
        （接口在 io.ddd4j.core.cqrs.readmodel，本模块不重定义），双面 API——
        响应式方法（Mono/Flux）供响应式运行时直组，同步桥接方法满足 core SPI；
        单条 MERGE INTO 原子 upsert（H2 实证语法）。
    </description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencies>
        <!-- For DDD4j -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-data-projection</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- R2DBC SPI（ConnectionFactory/Connection 响应式连接标准接口；
             版本由 ddd4j-dependencies 的 ${r2dbc-spi.version}=1.0.0.RELEASE 管理（:553）） -->
        <dependency>
            <groupId>io.r2dbc</groupId>
            <artifactId>r2dbc-spi</artifactId>
        </dependency>
        <!-- Reactor 核心（Mono/Flux 组装；版本由 reactor-bom 2025.0.6 导入管理（:6461）） -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- ======== Test ======== -->
        <!-- r2dbc-h2（纯响应式 H2 内存库 IT 用，无容器；版本由 ddd4j-dependencies 管理（:8052）） -->
        <dependency>
            <groupId>io.r2dbc</groupId>
            <artifactId>r2dbc-h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Reactor 测试（StepVerifier 断言 Mono/Flux 信号序列；版本随 reactor-bom） -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- surefire 默认不含 *IT.java；本模块的纯 r2dbc-h2+H2 集成测试随 test 阶段执行，
                 需在父配置（**/*Test.java 之外）追加 IT 模式。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
