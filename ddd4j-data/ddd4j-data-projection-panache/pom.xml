<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-projection-panache</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 投影位置 Quarkus Panache 实现（Quarkus 运行时）：
        基于 Quarkus Hibernate ORM Panache（active record 公有字段风格）落地 core 的
        ProjectionPositionRepository SPI（接口在 io.ddd4j.core.cqrs.readmodel，本模块不重定义），
        PanacheProjectionPositionEntity + QuarkusProjectionPositionRepository 组装，
        与 ddd4j-data-projection-jpa 共用同款 ddd4j_projection_position 表结构。
    </description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencyManagement>
        <dependencies>
            <!-- Quarkus 平台 BOM（模块级再导入，= ddd4j-dependencies 同款 ${quarkus.version}）：
                 与 ddd4j-data-event-store-panache（Task 5.1）同款 parent-chain 防御，实测必要
                 （非冗余）。父 BOM 链中更早的 import 已把 hibernate-core 管理为面向 Framework 7
                 线的版本，压过 quarkus-bom 的对齐版——Quarkus 运行时按其自带 hibernate-orm 编译，
                 混版实测 @QuarkusTest 启动即 NoClassDefFoundError（Task 5.2 IT 实证教训）。
                 模块级 import 优先于父链管理项生效，使本模块的 Quarkus 全家桶
                 （hibernate-core、jakarta.persistence 等）整链对齐 quarkus-bom，
                 独立于 -jpa 模块的任何版本钉。 -->
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- For DDD4j -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-data-projection</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Quarkus Hibernate ORM Panache：版本由本模块再导入的
             io.quarkus.platform:quarkus-bom（${quarkus.version}=3.38.2）管理，刻意不声明。
             不继承也不钉 ddd4j-data-projection-jpa 模块的任何版本钉（阶段 4/5 教训：
             Quarkus 栈必须整链由 quarkus-bom 对齐，禁止与 Spring 线的 Hibernate/JPA 钉混用）。 -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>

        <!-- ======== Test ======== -->
        <!-- Quarkus JUnit 5 集成（@QuarkusTest 引导；3.31+ 由 quarkus-junit5 重定位至 quarkus-junit，BOM 管理） -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Quarkus H2 JDBC 驱动（@QuarkusTest 内存库 IT 用，BOM 管理，Docker 无关） -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- surefire 默认不含 *IT.java；本模块的 @QuarkusTest 集成测试（H2 内存库）
                 随 test 阶段执行，需在父配置（**/*Test.java 之外）追加 IT 模式。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
