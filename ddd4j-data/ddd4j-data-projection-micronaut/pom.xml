<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-projection-micronaut</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 投影调度 Micronaut CDI 适配（Micronaut 运行时）：
        MicronautProjectionScheduler 以 @Singleton 实现 ViewScheduler SPI
        （ScheduledExecutorService + CronExpression 兜底——Micronaut 4.x 编程式调度
        不可用时退化为 JDK 调度），MicronautProjectionViewManager 以 @Singleton
        实现 ViewManager SPI（BeanContext 收集 ProjectionView Bean + ProjectionRunner
        驱动 runOnce），@PostConstruct 自动启动——投影契约全部复用 ddd4j-core。
    </description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencyManagement>
        <dependencies>
            <!-- Micronaut 平台 BOM（模块级再导入，= ddd4j-data-cqrs-micronaut 同款，引用根 pom:448 的
                 ${micronaut.version}=4.10.17，刻意不声明本地版本属性）：沿 -event-store-panache /
                 -cqrs-quarkus 实证的模式预防父链混版——模块级 import 优先于父链管理项生效，使本模块的
                 Micronaut 全家桶整链由平台 BOM 对齐。 -->
            <dependency>
                <groupId>io.micronaut.platform</groupId>
                <artifactId>micronaut-platform</artifactId>
                <version>${micronaut.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- For DDD4j -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-data-projection</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Micronaut DI（BeanContext/@Singleton 构造型容器 API，jakarta.inject-api 随其传递；
             平台 BOM 管理无版本） -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-inject</artifactId>
        </dependency>
        <!-- Micronaut Runtime（运行时装配件：micronaut-context/context-propagation/aop 等随其传递，
             平台 BOM 管理无版本；适配器运行时栈整链对齐用） -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-runtime</artifactId>
        </dependency>

        <!-- ======== Test ======== -->
        <!-- Micronaut JUnit 5 集成（@MicronautTest 真实 BeanContext 引导；io.micronaut.test 组，
             平台 BOM 管理） -->
        <dependency>
            <groupId>io.micronaut.test</groupId>
            <artifactId>micronaut-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Micronaut 的 Bean 定义在编译期由注解处理器生成（micronaut-inject-java 产出
                 $Definition 类 + META-INF/services 的 BeanDefinitionReference 注册），
                 没有它 @Singleton 类对运行期 BeanContext 不可见。插件级配置同时作用于 main 与 test
                 编译（IT 的样例 view / @Factory 也需要生成 Bean 定义）。lombok 与根 pom:249 保持一致；
                 micronaut-inject-java 版本由上方模块级平台 BOM 管理。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>io.micronaut</groupId>
                            <artifactId>micronaut-inject-java</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- surefire 默认不含 *IT.java；本模块的 @MicronautTest 集成测试随 test
                 阶段执行，需在父配置（**/*Test.java 之外）追加 IT 模式。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
