<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-event-store-jdbi</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 事件存储 JDBI 实现（Javalin/Vert.x 等轻量运行时）：
        SQL-first 的纯 jdbi3-core 落地（无注解 SQL Object、零容器依赖），提供
        EventStore SPI 的关系型实现（JdbiEventStore）。
    </description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencies>
        <!-- For DDD4j -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- JDBI 核心（Statement/Handle API，不含 sqlobject）：ddd4j-dependencies 只定义了
             ${jdbi.version}=3.45.4 属性（:375）而无 dependencyManagement 条目（控制器预检），
             故此处显式声明版本，属性经继承解析。 -->
        <dependency>
            <groupId>org.jdbi</groupId>
            <artifactId>jdbi3-core</artifactId>
            <version>${jdbi.version}</version>
        </dependency>

        <!-- ======== Test ======== -->
        <!-- H2 内存库（纯 JDBI IT 用，无容器；版本由 ddd4j-dependencies 的 ${h2.version}=2.4.240 管理） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Jackson JSR-310（DomainEvent 的 ZonedDateTime 时间戳真实 Jackson 往返，
             mapper 经 findAndAddModules 发现 JavaTimeModule；版本由 BOM 链管理） -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- surefire 默认不含 *IT.java；本模块的纯 JDBI+H2 集成测试随 test 阶段执行，
                 需在父配置（**/*Test.java 之外）追加 IT 模式。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
