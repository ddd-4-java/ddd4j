<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
>
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-mybatis</artifactId>
    <description>ddd4j 数据层 - MyBatis 官方实现（零 MyBatis-Plus 依赖）：纯 MyBatis 3.x 风格的 RichRepository 实现，
        整合 mybatis-enhance（数据权限/国际化注解），适配 ddd4j-core 的 Repository SPI。
        等保数据加密通过自定义加密拦截器 + ddd4j-data-crypto 实现。
    </description>

    <dependencies>
        <!-- ddd4j 核心契约 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- ddd4j 工具箱 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-kit</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 加解密策略 SPI -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-data-crypto</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- ddd4j 统一注解（orm: BizKey/OnCreate/OnUpdate/TenantId/SystemId/OrderBy） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-annotation</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- MyBatis 官方 -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
        </dependency>
        <!-- mybatis-spring: 可选（Quarkus/Javalin 不需要） -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis-spring</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- mybatis-enhance-annotation（纯 Java 注解：权限/国际化） -->
        <dependency>
            <groupId>com.github.hiwepy</groupId>
            <artifactId>mybatis-enhance-annotation</artifactId>
        </dependency>
        <!-- mybatis-enhance-core（拦截器框架、TypeHandler、SQL 工具） -->
        <dependency>
            <groupId>com.github.hiwepy</groupId>
            <artifactId>mybatis-enhance-core</artifactId>
        </dependency>
        <!-- JSqlParser: SQL 解析/改写（租户拦截器/数据权限拦截器） -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
        </dependency>
        <!-- FastJSON2: JSON TypeHandler 支持 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>
    </dependencies>

</project>
