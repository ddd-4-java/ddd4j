<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-mybatis</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 数据层 - MyBatis 官方实现（零 MyBatis-Plus 依赖）：纯 MyBatis 3.x 风格的 RichRepository 实现， 通过 ddd4j 自有 Mapper 与扩展 SPI 适配 ddd4j-core 的 Repository SPI。 等保数据加密通过自定义加密拦截器 + ddd4j-data-crypto 实现。</description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencies>
        <!-- ddd4j 核心契约 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- ddd4j 工具箱 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-kit</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 加解密策略 SPI -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-data-crypto</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- ddd4j 统一注解（orm: BizKey/OnCreate/OnUpdate/TenantId/SystemId/OrderBy） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-annotation</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- MyBatis 官方 -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
        </dependency>
        <!-- JSqlParser: SQL 解析/改写（租户拦截器/数据权限拦截器） -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <exclusions>
                <!-- JSqlParser 将仅用于其基准测试的 JMH 声明为 compile；ddd4j 运行时不需要它。 -->
                <exclusion>
                    <groupId>org.openjdk.jmh</groupId>
                    <artifactId>jmh-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>collect-forbidden-spring-dependencies</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>tree</goal>
                        </goals>
                        <configuration>
                            <includes>org.springframework:*,org.springframework.*:*,org.mybatis:mybatis-spring</includes>
                            <outputFile>${project.build.directory}/forbidden-spring-dependencies.txt</outputFile>
                            <appendOutput>false</appendOutput>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-spring-dependencies</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <condition property="forbidden.spring.dependencies.present">
                                    <length file="${project.build.directory}/forbidden-spring-dependencies.txt"
                                            length="0" when="greater"/>
                                </condition>
                                <fail if="forbidden.spring.dependencies.present"
                                      message="ddd4j-data-mybatis 必须保持 Spring/MyBatis-Spring 无关，Spring 集成应由独立适配模块提供。"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
