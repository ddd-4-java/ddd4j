<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
>
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-mybatis</artifactId>
    <description>ddd4j 数据层 - MyBatis 官方实现（零 MyBatis-Plus 依赖）：纯 MyBatis 3.x 风格的 RichRepository 实现，
        整合 mybatis-enhance（数据权限/国际化注解），适配 ddd4j-core 的 Repository SPI。
        等保数据加密通过自定义加密拦截器 + ddd4j-data-crypto 实现。
    </description>

    <dependencies>
        <!-- ddd4j 核心契约 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- ddd4j 工具箱 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-kit</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 加解密策略 SPI -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-data-crypto</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- ddd4j 统一注解（orm: BizKey/OnCreate/OnUpdate/TenantId/SystemId/OrderBy） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-annotation</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- MyBatis 官方 -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
        </dependency>
        <!-- mybatis-enhance-annotation（纯 Java 注解：权限/国际化/加解密/签名） -->
        <dependency>
            <groupId>io.github.hiwepy</groupId>
            <artifactId>mybatis-enhance-annotation</artifactId>
        </dependency>
        <!-- mybatis-enhance-core（拦截器框架、SPI、SQL 工具） -->
        <dependency>
            <groupId>io.github.hiwepy</groupId>
            <artifactId>mybatis-enhance-core</artifactId>
        </dependency>
        <!-- mybatis-enhance-extension（数据权限/国际化/加解密/签名拦截器、EnhanceMapper） -->
        <dependency>
            <groupId>io.github.hiwepy</groupId>
            <artifactId>mybatis-enhance-extension</artifactId>
        </dependency>
        <!-- mybatis-enhance-typehandler（JSON/集合/数组/Blob/RSA 等通用 TypeHandler） -->
        <dependency>
            <groupId>io.github.hiwepy</groupId>
            <artifactId>mybatis-enhance-typehandler</artifactId>
        </dependency>
        <!-- JSqlParser: SQL 解析/改写（租户拦截器/数据权限拦截器） -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
        </dependency>
        <!-- ======== Test ======== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-spring-dependencies</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>org.springframework.*:*</exclude>
                                        <exclude>org.mybatis:mybatis-spring</exclude>
                                    </excludes>
                                    <message>ddd4j-data-mybatis 必须保持 Spring 无关，Spring 集成应由独立适配模块提供。</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
