<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-event-store</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 事件存储模块：框架无关的 EventStore SPI（同步）+ AsyncEventStore SPI（Reactor 单轨，
        ADR-0005）+ Jackson 序列化抽象。不绑定任何运行时或持久化框架，
        实现由 ddd4j-data-event-store-{jpa,panache,jdbi,r2dbc} 提供。
    </description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencies>
        <!-- For DDD4j -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- For Jackson serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Reactor 核心（AsyncEventStore 的 Mono/Flux 响应式轨道，ADR-0005 单轨决策；
             版本由 ddd4j-dependencies 的 reactor-bom 2025.0.6 导入管理（:6464）） -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <!-- Jackson java.time 支持（仅测试需要：EventPayloadSerializerTest 的 ZonedDateTime 时间戳经
             JavaTimeModule 序列化；主代码 java.time 序列化由 ddd4j-kit JsonKit 自定义序列化器承担） -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
