<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-web</artifactId>
    <packaging>pom</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j Web 抽象聚合：统一 Web 语义、契约测试与多框架适配。</description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencies>
        <!-- Test -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <modules>
        <module>ddd4j-web-core</module>
        <module>ddd4j-web-testkit</module>
        <module>ddd4j-web-javalin</module>
        <module>ddd4j-web-javalin6</module>
        <module>ddd4j-web-quarkus</module>
        <module>ddd4j-web-micronaut</module>
        <module>ddd4j-web-vertx</module>
        <module>ddd4j-web-helidon</module>
        <module>ddd4j-web-dropwizard</module>
        <module>ddd4j-web-webflux</module>
        <module>ddd4j-web-webmvc</module>
    </modules>

</project>
