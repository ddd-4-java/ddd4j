<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-web</artifactId>
    <packaging>pom</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Ddd4j Web 抽象聚合：core（基础 Controller/Advice/Utils） + 各运行时框架桥接（Javalin/Spring WebFlux/WebMVC/Vertx/Micronaut/Helidon/Dropwizard/Quarkus）+ validation/testkit。</description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <!--
        ddd4j-web 子模块：
        2026-09-04 把根目录的 6 个 ddd4j-web-{javalin,vertx,micronaut,helidon,dropwizard,testkit}
        真实代码模块迁入 ddd4j-web/ 聚合根（parent 改 ddd4j-web），与 2.0.x/3.0.x 拓扑对齐。
        ddd4j-web-quarkus 删除（仅 .flattened-pom.xml 残留，无用户代码）；
        1.0.x 行不启用 Quarkus 集成（Quarkus 需要 JDK 17+）。
    -->
    <modules>
        <module>ddd4j-web-core</module>
        <module>ddd4j-web-javalin</module>
        <module>ddd4j-web-vertx</module>
        <module>ddd4j-web-micronaut</module>
        <module>ddd4j-web-helidon</module>
        <module>ddd4j-web-dropwizard</module>
        <module>ddd4j-web-webflux</module>
        <module>ddd4j-web-webmvc</module>
        <module>ddd4j-web-validation</module>
        <module>ddd4j-web-testkit</module>
    </modules>

</project>