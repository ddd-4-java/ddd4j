<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-auth</artifactId>
    <packaging>pom</packaging>
    <description>ddd4j 认证/授权抽象聚合：satoken/security/shiro 实现 + spring 桥接。
        Subject 契约（Subject/SubjectKit/SubjectProvider/AuthRequest/SubjectDataProvider/SubjectStrategy）
        定义在 ddd4j-core，本聚合提供三鉴权框架适配。Spring/Quarkus/Javalin 深度整合通过各自下游项目提供。
    </description>

    <dependencies>
        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <modules>
        <module>ddd4j-auth-satoken</module>
        <module>ddd4j-auth-security</module>
        <module>ddd4j-auth-shiro</module>
        <module>ddd4j-auth-spring</module>
    </modules>

</project>
