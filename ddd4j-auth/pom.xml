<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-auth</artifactId>
    <packaging>pom</packaging>
    <description>ddd4j 认证/授权抽象聚合：satoken/security/shiro 三个鉴权框架实现 + 框架独立性 ArchUnit
        守护测试（auth-archtest）。
        Subject 契约（Subject/SubjectKit/SubjectProvider/AuthRequest/SubjectDataProvider/SubjectStrategy）
        定义在 ddd4j-core。运行环境（Spring/Quarkus/Javalin）的鉴权桥接通过 ddd4j-runtime-* 提供，不属于本聚合。
    </description>

    <dependencies>
        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- AssertJ（流式断言） -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <modules>
        <module>ddd4j-auth-satoken</module>
        <module>ddd4j-auth-security</module>
        <module>ddd4j-auth-shiro</module>
    </modules>

</project>
