<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-auth</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-auth-security</artifactId>
    <description>Ddd4j Security Component（Spring Security 适配，允许 Spring 依赖）</description>

    <dependencies>
        <!-- 纯 Java 契约（Subject 体系定义在 ddd4j-core） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Spring Security（公开坐标，替代原 hiwepy 安全启动器） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-web</artifactId>
        </dependency>
        <!-- Spring（本模块允许依赖 Spring） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- JWT 扩展依赖待 hiwepy 3.3.x 发布后启用。 -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- 排除依赖未发布 hiwepy 私仓的 JWT 扩展类，待 3.3.x 发布后移除 exclusion -->
                    <excludes>
                        <exclude>**/jwt/**</exclude>
                        <exclude>**/WebSecurityJwtConfiguration.java</exclude>
                        <exclude>**/WebSecurityBizConfiguration.java</exclude>
                        <exclude>**/SecurityConstants.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
