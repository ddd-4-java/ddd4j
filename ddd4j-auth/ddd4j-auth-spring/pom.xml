<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-auth</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-auth-spring</artifactId>
    <description>Ddd4j Auth Spring 桥接：SubjectRegistrar（把 SubjectProvider Bean 写回 SubjectKit）+ 三鉴权 Spring 自动装配。</description>

    <dependencies>
        <!-- 纯 Java 契约（通过 auth-core 统一入口） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-auth-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Spring（本模块允许依赖 Spring） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Spring Boot 自动装配（@ConditionalOnClass / @AutoConfiguration） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>3.5.6</version>
            <optional>true</optional>
        </dependency>
        <!-- sa-token 实现（可选，按 classpath 自动装配） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-auth-satoken</artifactId>
            <version>${revision}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- shiro 实现（可选，按 classpath 自动装配） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-auth-shiro</artifactId>
            <version>${revision}</version>
            <optional>true</optional>
        </dependency>
        <!-- shiro-core（ShiroExceptionHandler 编译期需要，optional 不传递） -->
        <dependency>
            <groupId>org.apache.shiro</groupId>
            <artifactId>shiro-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- security 实现（可选，按 classpath 自动装配） -->
        <!-- 暂时注释：hiwepy security starter 未发布到私仓，待发布后取消注释
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-auth-security</artifactId>
            <version>${revision}</version>
            <optional>true</optional>
        </dependency>
        -->
    </dependencies>

</project>
