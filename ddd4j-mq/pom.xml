<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-mq</artifactId>
    <packaging>pom</packaging>
    <description>ddd4j 消息队列抽象聚合：-core(纯 Java MQ SPI) + -spring(Spring Messaging 桥接)
        + 多 Broker/本地实现（ActiveMQ/Disruptor/Kafka/MQTT/NATS/ONS/Pulsar/RabbitMQ/Redis Stream/RocketMQ/SQS/TDMQ）。
        Spring Boot 自动装配留在外部 ddd4j-boot，当前仓库直接纳管各 Broker adapter。
    </description>

    <dependencies>
        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <modules>
        <module>ddd4j-mq-core</module>
        <module>ddd4j-mq-activemq</module>
        <module>ddd4j-mq-disruptor</module>
        <module>ddd4j-mq-kafka</module>
        <module>ddd4j-mq-mqtt</module>
        <module>ddd4j-mq-mqtt-mica</module>
        <module>ddd4j-mq-nats</module>
        <module>ddd4j-mq-ons</module>
        <module>ddd4j-mq-pulsar</module>
        <module>ddd4j-mq-rabbitmq</module>
        <module>ddd4j-mq-redis-stream</module>
        <module>ddd4j-mq-rocketmq</module>
        <module>ddd4j-mq-sqs</module>
        <module>ddd4j-mq-tdmq</module>
        <module>ddd4j-mq-spring</module>
    </modules>

</project>
