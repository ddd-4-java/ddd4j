<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-mq</artifactId>
    <packaging>pom</packaging>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j 消息队列抽象聚合：-core(纯 Java MQ SPI) + -spring(Spring Messaging 桥接)
        + 多 Broker/本地实现（ActiveMQ/Disruptor/Kafka/MQTT/NATS/ONS/Pulsar/RabbitMQ/Redis Stream/RocketMQ/SQS/TDMQ）。
        Spring Boot 自动装配留在外部 ddd4j-boot，当前仓库直接纳管各 Broker adapter。
    </description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <subprojects>
        <subproject>ddd4j-mq-core</subproject>
        <subproject>ddd4j-mq-activemq</subproject>
        <subproject>ddd4j-mq-disruptor</subproject>
        <subproject>ddd4j-mq-kafka</subproject>
        <subproject>ddd4j-mq-mqtt</subproject>
        <subproject>ddd4j-mq-mqtt-mica</subproject>
        <subproject>ddd4j-mq-nats</subproject>
        <subproject>ddd4j-mq-ons</subproject>
        <subproject>ddd4j-mq-pulsar</subproject>
        <subproject>ddd4j-mq-rabbitmq</subproject>
        <subproject>ddd4j-mq-redis-stream</subproject>
        <subproject>ddd4j-mq-rocketmq</subproject>
        <subproject>ddd4j-mq-sqs</subproject>
        <subproject>ddd4j-mq-tdmq</subproject>
        <subproject>ddd4j-mq-spring</subproject>
    </subprojects>

</project>
