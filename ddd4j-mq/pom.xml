<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-mq</artifactId>
    <packaging>pom</packaging>
    <description>ddd4j 消息队列抽象聚合：-core(纯 Java MQ SPI) + -spring(Spring Messaging 桥接) + 13 个 broker 实现。Quarkus/Javalin 桥接通过 ddd4j-quarkus/ddd4j-javalin 顶层模块提供。</description>

    <dependencies>
        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <modules>
        <module>ddd4j-mq-core</module>
        <module>ddd4j-mq-spring</module>
        <module>ddd4j-mq-activemq</module>
        <module>ddd4j-mq-disruptor</module>
        <module>ddd4j-mq-kafka</module>
        <module>ddd4j-mq-mqtt</module>
        <module>ddd4j-mq-mqtt-mica</module>
        <module>ddd4j-mq-nats</module>
        <module>ddd4j-mq-ons</module>
        <module>ddd4j-mq-pulsar</module>
        <module>ddd4j-mq-rabbitmq</module>
        <module>ddd4j-mq-redis-stream</module>
        <module>ddd4j-mq-rocketmq</module>
        <module>ddd4j-mq-sqs</module>
        <module>ddd4j-mq-tdmq</module>
    </modules>

</project>
