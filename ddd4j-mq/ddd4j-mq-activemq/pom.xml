<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-mq</artifactId>
        <version>3.0.x.20260630-SNAPSHOT</version>
    </parent>

    <artifactId>ddd4j-mq-activemq</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Ddd4j ActiveMQ Artemis JMS adapter based on the line-specific client and ddd4j MQ SPI. Pure Java, zero
        Spring.
    </description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencies>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-mq-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!--
          本线使用 Apache ActiveMQ Artemis 2.44.0 的 artemis-jakarta-client 与 jakarta.jms。
          版本由本线 BOM 管理；BrokerType.ACTIVEMQ 是 ddd4j 的枚举名称，不声明 Classic v5 兼容。
        -->
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>artemis-jakarta-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
