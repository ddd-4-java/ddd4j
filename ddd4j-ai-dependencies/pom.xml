<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-ai-dependencies</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>ddd4j AI 依赖聚合模块：LLM / 智能体 / 多模态 AI SDK 统一依赖（版本由 ddd4j-dependencies BOM 集中管理）。当前已收录 3 个组件：claudecode-java-sdk（Anthropic Claude Code）、codex-java-sdk（OpenAI Codex CLI）、dreamina-java-sdk（字节跳动 Dreamina AI 绘图）。其余 AI 组件（openclaw/opencode/opencli）由于上游 pom 缺显式 jackson-databind 依赖暂未收录，待上游修复后增量加入。</description>
    <url>https://github.com/ddd-4-java/${project.artifactId}</url>

    <dependencies>
        <!-- Anthropic Claude Code Java SDK（Easy4J 封装）：CLI/SDK 方式调用 Claude Code 会话 -->
        <dependency>
            <groupId>io.github.easy4j</groupId>
            <artifactId>claudecode-java-sdk</artifactId>
        </dependency>
        <!-- OpenAI Codex CLI Java SDK（Easy4J 封装）：调用 OpenAI Codex CLI 执行编码任务 -->
        <dependency>
            <groupId>io.github.easy4j</groupId>
            <artifactId>codex-java-sdk</artifactId>
        </dependency>
        <!-- 字节跳动 Dreamina AI 绘图 Java SDK（Easy4J 封装）：调用 Dreamina 文生图 API -->
        <dependency>
            <groupId>io.github.easy4j</groupId>
            <artifactId>dreamina-java-sdk</artifactId>
        </dependency>
    </dependencies>

</project>
