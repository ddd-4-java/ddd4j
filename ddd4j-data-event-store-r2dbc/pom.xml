<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-data-event-store-r2dbc</artifactId>
    <packaging>jar</packaging>

    <name>ddd4j-data-event-store-r2dbc</name>
    <description>AsyncEventStore 的 R2DBC SPI + Reactor 响应式适配器：TEXT payload schema、事务内乐观锁校验、懒建表，无框架绑定（JDK8）</description>

    <dependencies>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${revision}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.baomidou</groupId>
                    <artifactId>mybatis-plus</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.hiwepy</groupId>
                    <artifactId>mybatis-plus-enhance</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- R2DBC SPI（版本由 ddd4j-dependencies 的 r2dbc-spi.version 管理，运行时由 ConnectionFactory 实现提供） -->
        <dependency>
            <groupId>io.r2dbc</groupId>
            <artifactId>r2dbc-spi</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Reactor（版本由 reactor-bom 管理） -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <!-- 测试：R2DBC H2 内存库 -->
        <dependency>
            <groupId>io.r2dbc</groupId>
            <artifactId>r2dbc-h2</artifactId>
            <!-- 覆盖全局 r2dbc-h2.version=1.1.0.RELEASE：其编译期依赖 H2 2.4.240
                 （Session.prepareCommand(String) 单参签名，Java 11 字节码），与 JDK8 轨道
                 不兼容；1.0.0.RELEASE 基于 R2DBC SPI 1.0.0 + H2 2.1/2.2 API（Java 8） -->
            <version>1.0.0.RELEASE</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <!-- 覆盖全局 h2.version=2.4.240（Java 11 字节码）：2.2.224 为最后的 Java 8 版本 -->
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
        <!-- 测试容器轨（PostgreSQL 方言验证，容器环境另行启用） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 覆盖 parent 的 surefire skip=true，本模块运行契约测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                    <argLine>-Xmx1024m -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
