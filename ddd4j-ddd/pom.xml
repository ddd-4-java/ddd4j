<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j</groupId>
        <artifactId>ddd4j-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-ddd</artifactId>
    <packaging>jar</packaging>

    <name>ddd4j-ddd</name>
    <description>DDD 基础设施层：集成 fuinorg ddd-4-java + cqrs-4-java，提供纯净的 DDD/CQRS/Event Sourcing 轨道，领域层零 MyBatis Plus 依赖</description>

    <!-- 强制 JUnit 子模块版本对齐（修复 spring-biz 传递的 5.8.2 与 SB 3.4 的 6.0.1 冲突） -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ============================================================ -->
        <!-- fuinorg DDD + CQRS：纯净 DDD 轨道的核心依赖                    -->
        <!-- 领域层契约（AggregateRoot / DomainEvent / Command）来自这里    -->
        <!-- ============================================================ -->

        <!-- ddd-4-java-core：聚合根/实体/值对象/领域事件契约（纯 Java，零框架依赖） -->
        <dependency>
            <groupId>org.fuin.ddd4j</groupId>
            <artifactId>ddd-4-java-core</artifactId>
        </dependency>

        <!-- ddd-4-java-jackson：AbstractDomainEvent / AbstractAggregateCommand 的 Jackson 序列化基类 -->
        <dependency>
            <groupId>org.fuin.ddd4j</groupId>
            <artifactId>ddd-4-java-jackson</artifactId>
        </dependency>

        <!-- ddd-4-java-esc：EventStoreRepository（事件溯源仓储实现，依赖 esc-api） -->
        <dependency>
            <groupId>org.fuin.ddd4j</groupId>
            <artifactId>ddd-4-java-esc</artifactId>
        </dependency>

        <!-- cqrs-4-java-core：Command / CommandExecutor / Result / JpaView（纯 Java） -->
        <dependency>
            <groupId>org.fuin.cqrs4j</groupId>
            <artifactId>cqrs-4-java-core</artifactId>
        </dependency>

        <!-- cqrs-4-java-jackson：AbstractAggregateCommand / Result 的 Jackson 序列化 -->
        <dependency>
            <groupId>org.fuin.cqrs4j</groupId>
            <artifactId>cqrs-4-java-jackson</artifactId>
        </dependency>

        <!-- ============================================================ -->
        <!-- ddd4j-core：复用统一响应/异常/注解体系（非 MyBatis 部分）  -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${revision}</version>
            <exclusions>
                <!-- 本模块是纯 DDD 轨道，排除 MyBatis Plus 相关 -->
                <exclusion>
                    <groupId>com.baomidou</groupId>
                    <artifactId>mybatis-plus</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.hiwepy</groupId>
                    <artifactId>mybatis-plus-enhance</artifactId>
                </exclusion>
                <!-- 排除 spring-biz 传递的旧版 JUnit（5.8.2 compile scope），避免与 SB 3.4 的 6.0.1 冲突 -->
                <exclusion>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ============================================================ -->
        <!-- Spring Boot：自动配置支持                                     -->
        <!-- ============================================================ -->

<!-- Jandex：运行时按注解自动发现 EntityId / SerializedDataType（fuinorg 依赖） -->
        <dependency>
            <groupId>io.smallrye</groupId>
            <artifactId>jandex</artifactId>
        </dependency>

        <!-- esc-mem：内存版事件存储，开发/测试用（无需部署 EventStoreDB） -->
        <dependency>
            <groupId>org.fuin.esc</groupId>
            <artifactId>esc-mem</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ============================================================ -->
        <!-- 测试依赖                                                      -->
        <!-- ============================================================ -->
        <!-- ArchUnit：分层约束验证（自带 JUnit 5 引擎依赖） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 覆盖 parent 的 surefire 配置：本模块允许运行单元测试，并修正 JDK8 遗留的 PermSize 参数 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                    <argLine>-Xmx1024m -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
